# Existing RHA backend API
RHA_BACKEND_URL=https://dashboard.picki.com.au
RHA_PUBLIC_LEAD_PATH=/api/public/leads

# Server-only key used by the contact proxy
RHA_LEADS_API_KEY=replace-with-local-secret

# Public site URL
NEXT_PUBLIC_SITE_URL=https://new.ripehouseadvisory.com.au

# Webflow CMS source for Market Intel content
WEBFLOW_API_KEY=replace-with-webflow-token
WEBFLOW_SITE_ID=6784a240509d2ca9e7e38e06
WEBFLOW_BLOG_COLLECTION_ID=678b03cab43dc836bed9f0bd
WEBFLOW_STAFF_COLLECTION_ID=6786e1e7f29f7f1a8d017d04

# Server-only Calendly personal access token (bookings/webhooks - NOT needed by
# the /discovery-call embed, which uses the public scheduling link).
CALENDLY_API_KEY=replace-with-calendly-token

# Server-only token for blog create/update/delete operations
BLOG_ADMIN_TOKEN=replace-with-admin-token

# Public read-only CAGR feed used by /about/approach
RHA_CAGR_API_URL=https://dashboard.picki.com.au/api/public/approach/cagr

# Shared secret for the dashboard to trigger on-demand cache purges (see
# app/api/revalidate/route.js) right after a case study / property AVM save,
# instead of waiting out the case-studies fetch revalidate window. Must match
# RHA_WEBSITE_REVALIDATE_SECRET in rha-dashboard.
REVALIDATE_SECRET=replace-with-shared-secret

# Client-side analytics. Both default to the production RHA IDs (same ones the
# old Webflow site uses) when unset.
NEXT_PUBLIC_META_PIXEL_ID=2200362480052876
NEXT_PUBLIC_GA4_ID=G-TTGS57HCP5

# Dashboard base URL for the identity-resolution tracker (browser-direct posts
# to /api/ir/* so the dashboard captures the visitor's real IP).
NEXT_PUBLIC_RHA_IR_URL=https://dashboard.picki.com.au
